    "performers": {
        "gaz-brookfield": {
            "id": "gaz-brookfield",
            "name": "Gaz Brookfield",
            "url": "https://gazbrookfield.com/",
            "instagram": "gazbrookfield",
            "facebook": "gazbrookfieldmusic",
            "facebook_group": "1438746349768477",
            "musician": true,
            "bio": "West country based Gaz Brookfield is an award winning solo acoustic musician, with two number one albums to his name.\n\n\n\nHe has spent the last fifteen years tirelessly touring all over the UK and beyond, building a strong and loyal following wherever he goes.\n\n\n\nBrookfield was the first independent musician to sell out Bristol's The Fleece (450 cap) and The Bierkeller (750 cap) and more recently SWX (1000 cap).\n\n\n\nGaz has an impressive ten album strong back catalogue. In the autumn of 2023, Gaz's ninth album, 'Morning Walking Club', saw him achieve his first number one in the Official UK Folk Albums Chart.\n\n\n\nBrookfield got his second number one album in September 2025, when 'Waiting for Wisdom' topped the Official UK Download Charts.\n\n\n\nNot a bad result for this fiercely independent musician, with no record label, no manager, no agent - just a guitar, a van, and a steadfastly belligerent refusal to give in."
        },
        "bassie-gracie": {
            "id": "bassie-gracie",
            "name": "Bassie Gracie",
            "poet": true,
            "url": "https://www.facebook.com/bassiegracie",
            "bio": "In her own words, \"'I'm Grace, I play the bass, people take photos of my face, I do poetry but I struggle with rhymes.\""
        },
        "nick-parker": {
            "id": "nick-parker",
            "name": "Nick Parker",
            "url": "https://nick-parker.co.uk/",
            "facebook": "nickparkertheperson",
            "instagram": "nick_parker_music",
            "musician": true,
            "bio": "Glastonbury based Nick Parker started gigging in his early teens playing mandolin and singing in folk/rock/skiffle band 'Why?', and spent the next 10 years bouncing around on stages at hundreds of venues and festivals around the UK and Europe. In 2010 Nick embarked on a solo career and has since enjoyed over 30 tours around the UK and Europe, releasing five full-length albums along the way, many songs from which have been featured on BBC6 Music among many other radio stations.\n\n\n\nAlthough primarily a solo effort Nick often plays with his band 'Nick Parker and the False Alarms' which is a folky/rocky/country affair using guitars, fiddle, pedal steel, banjo, mandolin, cornet, accordion, keys, whistles, pipes, bass and drums, often with various members switching instruments when space permits. At a recent gig the band were described as 'A British Arcade Fire', something that Nick was very pleased about. Nick also often gigs as a duo with fiddle player Ben Wain."
        }
    },
